# ==============================================================================
# WalletIQ v2.0 — Production Environment Configuration
# ==============================================================================

# Core Application Settings
FLASK_APP=app.py
FLASK_ENV=production
# Generate a cryptographically strong key, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_64_character_hex_key
PORT=5000

# Security & Reverse Proxy
# Set to 'true' in production behind HTTPS (Render, Railway, ALB, Cloudflare, Nginx)
SESSION_COOKIE_SECURE=true
# Set to 'true' to enable ProxyFix for accurate client IP tracking and rate limiting behind reverse proxies
BEHIND_PROXY=true

# Cross-Origin Resource Sharing (CORS) for Vercel Frontend
# Comma-separated list of allowed origins (Vercel deployment domain + local dev)
CORS_ORIGINS=https://walletiq.vercel.app,https://your-walletiq-app.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# Frontend Environment Variable (Set in Vercel project dashboard):
# VITE_API_BASE_URL=https://your-backend.up.railway.app

# Database Configuration (Option A: Unified Connection URL - Recommended for Cloud)
# Format: mysql+pymysql://user:password@host:port/dbname or postgresql://user:password@host:port/dbname
# DATABASE_URL=mysql+pymysql://walletiq:securepassword@db:3306/walletiqdb

# Database Configuration (Option B: Individual Parameters - Used if DATABASE_URL is unset)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=walletiq
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=walletiqdb

# Database Connection Pool Tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=280

# Database SSL Support (e.g., AWS RDS, GCP Cloud SQL, Aiven, or DigitalOcean CA cert path)
# MYSQL_SSL_CA=/path/to/ca-cert.pem

# Container Orchestration & Migrations
# Set to 'true' to automatically execute 'flask db upgrade' upon container startup
AUTO_MIGRATE=true
# Set to 'true' in Docker Compose to wait for the database service to accept connections before starting
WAIT_FOR_DB=true
DB_CONNECT_RETRIES=30

# Gunicorn WSGI Concurrency & Performance
# Recommended: 2-4 workers on 512MB-1GB RAM instances to avoid Out-Of-Memory kills
WEB_CONCURRENCY=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_ACCESSLOG=-
GUNICORN_ERRORLOG=-
GUNICORN_LOGLEVEL=info

# Gemini AI Credentials (Google AI Studio)
# Get your API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy...
